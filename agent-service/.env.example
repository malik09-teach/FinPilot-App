# Agent Service Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Backend Internal API (must match backend/.env)
BACKEND_BASE_URL=http://localhost:4000
AGENT_SERVICE_TOKEN=dev-agent-service-token

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL_ROUTER=openai/gpt-oss-20b
GROQ_MODEL_AGENT=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3

# Tavily Search API – used by Investment Researcher agent for live market data
# Get your free key at https://app.tavily.com
TAVILY_API_KEY=

# Runtime Limits & Concurrency
MAX_TOOL_STEPS=6
MAX_REQUEST_TOKENS=8192
PER_TOOL_TIMEOUT_SECONDS=10
OVERALL_TIMEOUT_SECONDS=45
MAX_CONCURRENT_GLOBAL=32
MAX_CONCURRENT_PER_USER=3
HISTORY_WINDOW_MESSAGES=12
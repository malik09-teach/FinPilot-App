# FinPilot Shared Environment Variables Reference
NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=finpilot-jwt-secret-key

# AI Engine Integration (Backend <-> Python Agent Service)
AI_ENGINE=python
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=change-me-service-token
AGENT_CONTEXT_SECRET=change-me-context-secret-min-16-chars
AGENT_CONTEXT_TTL_SECONDS=120

# Groq LLM Configuration (Agent Service)
GROQ_API_KEY=
GROQ_MODEL_ROUTER=
GROQ_MODEL_AGENT=
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=3
